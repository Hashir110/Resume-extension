# Copy to .env.local for local development.
# NODE_ENV is set automatically by Next.js; listed here for reference only.
NODE_ENV=development

# SQLite for now (see docs/assumptions.md). Path is relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# REQUIRED. Signs/encrypts the JWT session cookie (Auth.js / next-auth v5).
# Generate your own per environment — never share or reuse one across
# environments, and NEVER put a real value here:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Explicitly selects which AI provider POST /api/jobs/[id]/{analyze,match,tailor}
# use. Server-side only — never exposed to the browser.
#
#   fake   -> FakeAIProvider's offline simulation. LOCAL DEVELOPMENT/TESTING
#             ONLY — makes no external API call at all, so it works with no
#             API key and never fails from provider outages/rate limits.
#             Produces realistic, evidence-grounded (but not real-AI-quality)
#             results derived from the actual job/resume data. Never use in
#             production — it is not a real AI provider.
#   gemini -> GeminiProvider. Real AI provider; requires GEMINI_API_KEY.
#   openai -> OpenAIProvider. Real AI provider; requires OPENAI_API_KEY.
#   auto   -> (default when unset) Gemini if configured, else OpenAI, else a
#             controlled 501 AI_PROVIDER_NOT_CONFIGURED error.
AI_PROVIDER=gemini

# Required when AI_PROVIDER=gemini (or auto, as the preferred provider).
# NEVER commit a real key here — this file is a shareable template. Put your
# real key in .env.local instead (already gitignored).
GEMINI_API_KEY=
# Optional, defaults to gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash
# Optional. Only used if the primary model fails with a retryable 429/503
# after exhausting its own retries — tried once (with one retry of its own).
GEMINI_FALLBACK_MODEL=gemini-3.7-flash

# OPENAI_API_KEY=
# # Optional, defaults to gpt-4o-mini.
# OPENAI_MODEL=

# DEVELOPMENT-ONLY. When "true" (and NODE_ENV is not "production"), every
# tailoring request skips the JobAnalysis/ResumeJobMatch/TailoringPlan cache
# and always calls the AI provider fresh — useful for confirming a real
# provider (e.g. Gemini) is actually being invoked rather than looking at a
# result reused from an earlier run under a different provider. Read via
# process.env only (never a NEXT_PUBLIC_* var), so it can't be toggled from
# the browser/client, and it's a no-op outside development — leave it unset
# for normal use, since disabling the cache means slower, costlier requests.
# AI_DISABLE_AI_CACHE=true

# Optional. Overrides the FREE plan's monthly AI-tailoring-generation limit
# (default: 5, see src/lib/billing/plan-config.ts — the one place this value
# lives). Lower it locally if you want to reach the limit faster while
# testing. PRO accounts are always unlimited regardless of this value.
# FREE_PLAN_MONTHLY_TAILORING_LIMIT=5
